# Per-user, never committed
USER.md
.private/

# Local environment / secrets
.env
.env.*
!.env.example
*.local

# Knowledge layer — local vector store / graph build artifacts (sources + manifest stay tracked)
docs/knowledge/.index/
docs/knowledge/*.duckdb
docs/knowledge/*.sqlite
# Derived per-namespace graph DBs + the global overlay (Phase 4)
**/.knowledge/

# Dashboard local DB
dashboard/*.db
dashboard/*.sqlite
scripts/session/.usage-errors.log

# Per-user session metrics — personal usage data (who ran what, tokens, cost).
# Never ship these in the framework template; a project decides per-situation
# whether to track its own. The README documenting the folder stays tracked.
docs/metrics/sessions/*
!docs/metrics/sessions/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-ai-governance/
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# Generated binary deliverables (markdown is the source of truth — see AGENTS.md §7)
*.docx
*.pptx
!docs/**/templates/*.docx
# The brand skill ships its slim deck template (a skill asset, not a generated deck).
!.claude/skills/frq-brandbook/assets/templates/*.pptx

# Deck builder (docs/decks/README.md): per-run snapshots/metrics, rendered decks,
# and brand binaries (template .potx, logos, key visuals) stay out of git.
/.ai-sdlc/decks/
/out/decks/
docs/brand/*/assets/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
